# Parrot 配置切面示例（三层优先级：代码显式设置 > 本文件 > 编译期默认）
#
# 部署最小化：本文件可以不存在（全默认启动，行为与配置切面引入前完全
# 一致）。按需覆盖——只写想改的键。
#
# 环境变量展开：${VAR} / ${VAR:-default}（K8s ConfigMap 注入风格）。
# 默认 parrot.toml 可不存在；PARROT_CONFIG 或 load_file 显式指定的文件必须存在。
# 未知键、类型错误、非法角色/载体和不合法容量会报错，不会静默使用默认值。

# ---------------------------------------------------------------------------
# [topology] -- originating business traffic; roles remain under remote.node
# ---------------------------------------------------------------------------
[topology]
# hub: prefer the live hub; mesh: direct only; hybrid: direct then optional relay
#mode = "hybrid"
# Hub: direct fallback when no live hub exists; hybrid: relay after direct failure.
# Mesh never relays. A hub/border endpoint can send directly to its spokes.
#relay_fallback = true
# Administrative and mirror traffic always uses the named direct destination.

# ---------------------------------------------------------------------------
# [thread] —— ThreadActorSystem 调度域
# ---------------------------------------------------------------------------
[thread]
# 共享调度池核心线程数（默认 CPU 核数）
#shared_pool_size = 8
# 弹性突发 worker 上限（默认 CPU 核数）
#shared_burst_workers_max = 8
# 队列积压多久后扩突发 worker，毫秒（默认 100）
#shared_burst_backlog_threshold_ms = 100
# 突发 worker 空闲多久回收，毫秒（默认 5000）
#shared_burst_idle_timeout_ms = 5000
# 共享调度队列容量（默认 10000）
# 高/普通优先级共用的就绪队列容量；满时合并到已有 actor 注册状态等待调度。
# 不限制 actor 数量；每个邮箱仍按自己的容量对生产者施加背压。
#shared_queue_capacity = 10000
# 专用线程上限（默认 32）
#max_dedicated_threads = 32
# actor 默认邮箱容量（默认 1024）
#default_mailbox_capacity = 1024
# 每个 actor 同时存活的 Context 定时任务上限（默认 1024；0 禁用）
# 已完成的一次性任务释放名额；周期任务占一个名额直至停止或投递失败
#max_context_tasks = 1024
# ask 默认超时，毫秒（默认 5000）
#default_ask_timeout_ms = 5000
# 系统关闭超时，毫秒（默认 10000）
#shutdown_timeout_ms = 10000

# ---------------------------------------------------------------------------
# [remote.node] —— 节点身份与拓扑（部署强相关——最应外置的部分）
# ---------------------------------------------------------------------------
[remote.node]
# 节点唯一 id（多节点拓扑必填）
#node_id = "spoke-a"
# 监听地址 host:port
#bind = "0.0.0.0:9801"
# 拓扑角色 normal|hub|border|directory（默认 normal）
#topology_role = "normal"
# 可直拨地址（方案 A——hub 据此注入 ROUTE_HINT 促成 spoke 两两直连）
#direct_addr = "10.0.0.5:9801"
# 种子节点 ["tcp://node-id@host:port", ...]（node-id@ 可省略）
# 种子载体须与 scheme 一致；域名使用 RemoteConfig::from_resolved_async 解析。
# start 后自动尝试种子；本地启动成功不等于所有种子已经连通。
#seeds = ["tcp://hub@127.0.0.1:9800"]

# ---------------------------------------------------------------------------
# [remote.receptionist] -- service-key authorization, separate from TLS identity
# ---------------------------------------------------------------------------
[remote.receptionist]
# Unmatched node/key pairs are denied by default. Explicit false permits them.
#default_deny = true
# Grant local operations to this node and incoming snapshots to each publisher.
# Prefixes match complete segments: edge/public does not grant edge/publicity.
#roles = { spoke-a = ["edge/public"], spoke-b = ["edge/public"] }
# Higher-priority maps replace the complete inherited map; roles = {} clears it.
# default_deny inherits separately; clearing roles does not override false.
# Network service sync still requires verified mTLS or explicit development mode.
# These grants alone do not inject actor/message gateways into an application.

# ---------------------------------------------------------------------------
# [remote.transport] —— 连接层（原写死常量参数化）
# ---------------------------------------------------------------------------
[remote.transport]
# 心跳间隔，毫秒（默认 2000；半开检测延迟 ≈ interval × max_loss）
#heartbeat_interval_ms = 2000
# 连续丢失多少个间隔判半开断开（默认 5）
#heartbeat_max_loss = 5
# 出站帧队列容量（默认 1024——满则反压）
#outbound_queue = 1024
# 系统级未完成入站 ASK 上限（含等待 lookup / actor / 回复队列）
#inbound_ask_capacity = 1024
# 上述 ASK 的 path + type_key + payload 编码长度总预算；不是节点 RSS 上限
#inbound_ask_bytes = 67108864
# 系统级慢入站操作上限（TELL / STOP / 管理等，含排队与在途）
#inbound_dispatch_capacity = 1024
# 每条实际连接的慢操作上限；超额关闭该连接而非全局等待
#inbound_dispatch_per_connection = 64
# 上述慢操作的 payload / path / type_key / 来源节点名长度总预算
#inbound_dispatch_bytes = 67108864
# 帧默认跳数上限 1..=64（默认 8）
#default_hop_limit = 8

# ---------------------------------------------------------------------------
# [remote.reorder] —— TELL 端到端重排
# ---------------------------------------------------------------------------
[remote.reorder]
# 缺口等待上限，毫秒（默认 250——超时放行最小 seq 跳过丢失帧）
#gap_timeout_ms = 250
# 重排缓冲帧数上限（默认 1024——防对端异常打爆内存）
#buffer_cap = 1024

# ---------------------------------------------------------------------------
# [remote.codec] —— 编解码协商
# ---------------------------------------------------------------------------
[remote.codec]
# 附加能力位（连 pb-only 对端时叠加 caps::PB；默认 0=纯 bin）
#extra_caps = 0

# Optional persistent Directory group. Also set remote.node.topology_role = "directory"
# and configure mTLS for TCP/QUIC. The data directory must already exist.
# Voting peers are independent from remote.node.seeds; [] explicitly means solo.
# [remote.directory]
# storage_dir = "/private/parrot/directory"
# group = "control-plane"
# peers = ["tcp://directory-b@127.0.0.1:9802", "tcp://directory-c@127.0.0.1:9803"]
# election_ms = 2000
# heartbeat_ms = 150
# rpc_timeout_ms = 5000
