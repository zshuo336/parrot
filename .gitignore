# Application/workspace lockfiles are versioned; generated fixture/PoC locks are not.
**/Cargo.lock
!/Cargo.lock
tasks/
target/
temp_code/
gitcmd.sh
# Local caches and agent state (do not hide build/CI configuration).
.cache/
.codex/
.claude/
.scala-build/

# ---- P6 提交范围控制（2026-10-05）----
# IDE / 编辑器
.metals/
.vscode/
.idea/
# JS 构建产物与依赖
node_modules/
dist/
# JVM / Python / Erlang 构建产物
*.class
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
_build/
*.beam
# C/C++ 编译产物
*.o
*.a
*.so
*.dylib
# 系统文件
.DS_Store
interop/cpp-lite/bin/
*.dump
erl_crash.dump
gw-jvm-libs.tar

.cursorignore
